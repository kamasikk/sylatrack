# Зроби копію цього файлу з назвою .env і встав свій ключ після =
GEMINI_API_KEY=
# Не змінюй без потреби: FitMind використовує актуальну текстову модель за замовчуванням.
# GEMINI_MODEL=gemini-3.5-flash
# Для Netlify Function: публічний Web API key з firebaseConfig.
FIREBASE_WEB_API_KEY=
# Не публікуй .env і не надсилай його нікому.
